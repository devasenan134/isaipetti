# Copy to .env and fill in. Never commit .env.

# Where your music is on this machine (folders of albums; .lrc lyric files next to songs are picked up).
MUSIC_FOLDER=/path/to/music

# Your user and group id (run `id -u` and `id -g`).
PUID=1000
PGID=1000

# Optional: artist pictures and biographies. Get keys at https://www.last.fm/api and https://developer.spotify.com
ND_LASTFM_APIKEY=
ND_LASTFM_SECRET=
ND_SPOTIFY_ID=
ND_SPOTIFY_SECRET=
