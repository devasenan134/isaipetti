# Copy to .env and fill in. Never commit .env.

# How this server reaches Navidrome. From Docker on the same machine, host.docker.internal is that machine.
NAVIDROME_URL=http://host.docker.internal:4533

# A Navidrome admin account just for this server (see ../SELF_HOSTING.md, step 2).
NAVIDROME_ADMIN_USER=isaipetti-bot
NAVIDROME_ADMIN_PASSWORD=

# Your user and group id (run `id -u` and `id -g`); data/ and secrets/ must belong to them.
PUID=1000
PGID=1000

# Optional: bug reports and feature requests from the app become GitHub issues. Use a fine-grained token limited to
# one repository with only "Issues: Read and write" permission.
GITHUB_REPO=
GITHUB_TOKEN=

# Optional: mixes, playlists and stations by Isai Pettai. The folder with Navidrome's database (navidrome.db),
# which this server only reads, and the audio analyzer's data folder (see ../SELF_HOSTING.md, step 7) for moods and
# sound-alike radio. Without the analyzer, mixes use tags and listening only. Daily Mixes change at midnight here:
NAVIDROME_DATA=
FEATURES_FOLDER=
MIX_TIMEZONE=Asia/Kolkata
