# Copy to .env and fill in.

# Navidrome's data folder (with navidrome.db) and the music folder Navidrome plays from. Both are only read.
NAVIDROME_DATA=/path/to/navidrome/data
MUSIC_FOLDER=/path/to/music

# Where features.db (and the AI model, about 800 MB) are kept. The friends server reads features.db from here.
FEATURES_FOLDER=./data

# Your user and group id (run `id -u` and `id -g`).
PUID=1000
PGID=1000

# CPU cores it may use (the first run takes a while; later only new songs are analyzed).
ANALYZER_CPUS=4
